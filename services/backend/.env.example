# rednote-backend 环境变量样例（M1 WP06/WP07 骨架）
#
# 用法：
#   cd services/backend
#   cp .env.example .env
#   # 按本机/内网实际情况改 .env；.env 不得提交进版本库
#
# 口径（C6 安全）：
#   1) 本文件是「样例」，不含任何真实口令。
#   2) 代码里没有任何凭据默认值，DATABASE_URL 必须由环境变量注入；
#      未注入时服务照常启动，但 GET /api/v1/health/db 返回 503 DEPENDENCY_UNAVAILABLE。
#   3) 生产口令必须来自密钥管理系统，不允许落在 .env 明文里。

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------
REDNOTE_APP_NAME=rednote-backend
REDNOTE_APP_VERSION=0.1.0
REDNOTE_ENVIRONMENT=dev
REDNOTE_API_PREFIX=/api/v1
REDNOTE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 数据库（PostgreSQL 17 + pgvector）
#   本机原生 PG 示例（user=rednote / db=postgres / 无口令）：
#     REDNOTE_DATABASE_URL=postgresql+psycopg://rednote@localhost:5432/postgres
#   容器环境示例（口令来自密钥管理，不要写明文进版本库）：
#     REDNOTE_DATABASE_URL=postgresql+psycopg://rednote:${PG_PASSWORD}@postgres:5432/rednote
#
#   驱动固定用 psycopg 3（研发计划 §5）。
#
#   **G1 前端演示请指向 `rednote_dev`，不要用 `postgres`**：
#     `postgres` 库被历史测试反复写入（projects 已到 4 万量级），
#     列表页首屏会被测试残留淹没；`rednote_dev` 是只由
#     `tools/dev/seed_demo_data.py` 写入的独立库。
#     `seed_demo_data.py` 内置库名白名单（仅 `rednote_dev`）+ 环境黑名单
#     （prod/staging），指错库会直接退出码 1 拒绝执行。
# ---------------------------------------------------------------------------
# REDNOTE_DATABASE_URL=postgresql+psycopg://rednote@localhost:5432/postgres
# REDNOTE_DATABASE_URL=postgresql+psycopg://rednote@localhost:5432/rednote_dev

# ---------------------------------------------------------------------------
# 前端静态资源托管（G1 演示，默认关闭）
# ---------------------------------------------------------------------------
# 指向含 `login.html` / `projects.html` 等页面的目录。**留空 = 不挂载**，
# 路由表与不设此项时逐字节一致（CI / 生产安全）。
#
# 为什么前端必须由后端托管，而不是另起 5173 + CORS：
#   `platform/csrf.py` 的 `verify_csrf` 要求 `Origin` 严格等于后端自身
#   的 `scheme://netloc`（`localhost` 与 `127.0.0.1` 都算不同源）。
#   不同源时每个写请求都会 403 `origin_mismatch`。
#   唯一不削弱安全的解法是让两者同源 —— 即由后端托管静态页。
#
# 本机演示（相对 `services/backend/`）：
#   REDNOTE_FRONTEND_STATIC_DIR=static
REDNOTE_FRONTEND_STATIC_DIR=

# 登录放行后的前端落地页。仅允许站内路径（协议 §2：returnTo 仅本站路径）。
REDNOTE_FRONTEND_LANDING_PATH=/

# ---------------------------------------------------------------------------
# 开发登录旁路（G1 演示，仅 dev/test 生效）
# ---------------------------------------------------------------------------
# `POST /api/v1/dev/auth/login` 不需要 Keycloak：按邮箱 find-or-create 用户
# 并直接下发会话 Cookie。
#
# **这是装配期门控，不是运行期开关**：`create_app()` 只在
# `environment in {dev, test}` 时才 `include_router(devtools_router)`。
# 生产环境下该路径**根本不存在**（404，而非"存在但 403"）——
# 后者意味着代码与路由表仍然带着这块攻击面发布出去了。
#
# 因此本项**没有**配套的环境变量开关：能不能用，只取决于上面「应用」段
# 里的 `REDNOTE_ENVIRONMENT`（`dev` 或 `test` 才装配）。设成 prod/staging
# 即彻底消失。**这里不再重复定义该变量** —— 同一个键在两处赋值，
# 读者无法判断生效的是哪一个。

# 超时（C4 健壮性）：所有外部调用必须有显式超时数值，禁止 None。
#   connect_timeout      —— libpq 连接建立阶段上限，秒
#   statement_timeout_ms —— 服务端语句执行上限，毫秒（经连接参数下发给 PG）
#   health_total_timeout —— 健康检查整体的硬上限，秒（Python 侧兜底）
REDNOTE_DB_CONNECT_TIMEOUT_SECONDS=3
REDNOTE_DB_STATEMENT_TIMEOUT_MS=2000
REDNOTE_DB_HEALTH_TOTAL_TIMEOUT_SECONDS=3.0
REDNOTE_DB_POOL_SIZE=5
REDNOTE_DB_MAX_OVERFLOW=5
REDNOTE_DB_POOL_TIMEOUT_SECONDS=5