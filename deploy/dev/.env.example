# rednote-production 开发/试点环境变量样例（WP05）
#
# 用法：
#   cd deploy/dev
#   cp .env.example .env
#   # 编辑 .env 改掉所有 CHANGE_ME 口令
#   docker compose up -d
#
# 口径：
#   1) 本文件是「样例」，不含真实口令。.env 不得提交进版本库。
#   2) 变量名与 docker-compose.yml 中的 ${...} 一一对应，改名必须两边同时改。
#   3) 生产环境口令必须来自密钥管理系统，不允许落在 .env 明文里
#      （研发计划 §5：实施第一周锁版本并产出 SBOM；口令管理见 §10 运维口径）。

# ---------------------------------------------------------------------------
# 通用
# ---------------------------------------------------------------------------
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# PostgreSQL 17 + pgvector
#   注意：PG_DATABASE 只在「首次初始化数据卷」时生效；后续改名不会建新库。
# ---------------------------------------------------------------------------
PG_USER=rednote
PG_PASSWORD=CHANGE_ME_pg_password
PG_DATABASE=rednote
PG_PORT=5432

# ---------------------------------------------------------------------------
# MinIO（S3 兼容）
#   MINIO_ROOT_PASSWORD 官方要求长度 >= 8，dev 也请遵守，避免启动即失败。
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# RabbitMQ 4
# ---------------------------------------------------------------------------
RABBITMQ_USER=rednote
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
RABBITMQ_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_CONSOLE_PORT=15672

# ---------------------------------------------------------------------------
# Keycloak（profile=auth 时才使用；默认不启动）
#   26 起的管理员变量名是 KC_BOOTSTRAP_ADMIN_*（旧的 KEYCLOAK_ADMIN 已弃用）。
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_password
KEYCLOAK_PORT=8080

# ---------------------------------------------------------------------------
# WP05 冒烟脚本用的连接参数（tools/m0/wp05_smoke/smoke.py 读取同名变量）
#   默认值面向「本机原生 PG」：localhost:5432 / rednote / postgres / 无口令。
#   在容器环境里把下面几项改成与上面 PG_* 一致即可，无需改脚本。
# ---------------------------------------------------------------------------
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=rednote
# PG_PASSWORD=
# PG_DATABASE=postgres

# 文件腿：s3 = 打 MinIO endpoint；fs = 本地目录降级替身（不代表 MinIO 行为）
# SMOKE_BACKEND=s3
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=CHANGE_ME_minio_password
# S3_BUCKET=rednote-dev
# S3_REGION=us-east-1
# FS_BLOB_ROOT=evidence/m0/blobs
