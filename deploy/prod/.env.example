# rednote-production 内网**生产**环境变量样例（WP46 ①）
#
# 用法：
#   cd deploy/prod
#   cp .env.example .env
#   # 1) 改掉所有 CHANGE_ME（生产口令必须来自密钥管理系统，不是手敲）
#   # 2) 回填 IMAGE_* —— 取值的唯一权威是 images.lock.json，**不要在这里自创版本号**
#   ./install.sh --bundle /media/rednote-offline-<ts>
#
# 口径：
#   1) 本文件是「样例」，不含真实口令。.env 不得提交（.gitignore:21-24 已覆盖）。
#   2) 变量名与 docker-compose.yml 的 ${...} **一一对应**，改名必须两边同时改 ——
#      判据 `prod:image-refs-three-way` 会把 compose / 本文件 / images.lock.json
#      三方的 IMAGE_* 集合做双向对账，少一个或多一个都报红。
#   3) ⚠️ 下面 IMAGE_* 的默认值里有 3 个是 `PENDING` 标记（minio / gateway / prometheus）。
#      它们**不是能用的镜像引用**，`docker pull` 必失败 —— 这是刻意的：
#      在 digest 回填前让它响亮地失败，比让它悄悄拉到一个别的版本安全。
#      另 4 个是通道 tag（pg17 / 4-management / 26.0 / 0.1.0），**也没锁 digest**。
#      ⇒ 本文件原样 `cp` 之后 `docker compose up -d` **起不来**，这是已知且预期的状态。

# ---------------------------------------------------------------------------
# 通用
# ---------------------------------------------------------------------------
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 镜像引用（唯一权威：images.lock.json —— 本文件只是它的投影）
#
# 为什么镜像引用走环境变量而不是写死在 compose 里：内网走 Harbor（ADR-11 C5），
# 镜像名字前缀本身会变（registry.example.com/rednote/...）。写死 ⇒ 内网第一步就要改
# compose，而改过的 compose 不再被 check_offline_bundle.py 守着。
#
# 回填顺序（内网首日）：
#   1) 可出网机 `docker pull <ref>` → `docker inspect --format '{{index .RepoDigests 0}}'`
#   2) 取到 name@sha256:<64hex> → 写进 images.lock.json 的 digest 与 ref
#   3) 把本文件对应行改成同一个 ref（三方对账判据会核对）
#   4) `python tools/quality/check_offline_bundle.py` 必须仍然 PASS，
#      且 `prod:pending-digests-monotonic` 的实测数**下降** ⇒ 把脚本里的
#      _PENDING_DIGEST_BASELINE 同步调小（只许减，不许增）
# ---------------------------------------------------------------------------
IMAGE_POSTGRES=pgvector/pgvector:pg17
IMAGE_RABBITMQ=rabbitmq:4-management
IMAGE_MINIO=minio/minio:PENDING
IMAGE_KEYCLOAK=quay.io/keycloak/keycloak:26.0
IMAGE_APP=rednote/backend:0.1.0
IMAGE_GATEWAY=nginx:PENDING
IMAGE_PROMETHEUS=prom/prometheus:PENDING

# ---------------------------------------------------------------------------
# C1 PostgreSQL 17 + pgvector
#   PG_DATABASE 只在「首次初始化数据卷」时生效；后续改名不会建新库。
#   生产**不发布** 5432 端口（compose 里 postgres 没有 ports: 段）⇒ 这里没有 PG_PORT。
# ---------------------------------------------------------------------------
PG_USER=rednote
PG_PASSWORD=CHANGE_ME_pg_password
PG_DATABASE=rednote

# ---------------------------------------------------------------------------
# C3 MinIO
#   MINIO_ROOT_PASSWORD 官方要求长度 >= 8。
#   生产不开控制台（compose 的 command 里没有 --console-address）。
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
S3_BUCKET=rednote

# ---------------------------------------------------------------------------
# C2 RabbitMQ 4
#   生产不发布 15672 管理控制台。
# ---------------------------------------------------------------------------
RABBITMQ_USER=rednote
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
RABBITMQ_VHOST=/

# ---------------------------------------------------------------------------
# C4 Keycloak（profile=auth 时才启动；默认不启动）
#   KEYCLOAK_DB 是 Keycloak 自己的库，与应用库同实例不同库。
#   ⚠️ 该库**不会**被 ../dev/initdb 自动建出来 —— 需人工 createdb，
#      步骤写在 README.md §3「选装 Keycloak」，本包未在任何环境验证过（OP-52）。
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_password
KEYCLOAK_DB=keycloak

# ---------------------------------------------------------------------------
# C8 反向代理
#   [待核实: E2] 内部域名 / DNS / 内部 CA 未落地 ⇒ 当前只有 HTTP，没有 443。
#   证书到位后在 nginx/rednote.conf 里加 server 段并在此补 GATEWAY_HTTPS_PORT。
# ---------------------------------------------------------------------------
GATEWAY_HTTP_PORT=80
